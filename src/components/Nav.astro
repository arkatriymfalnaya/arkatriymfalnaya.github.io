---
const { current = '' } = Astro.props;
---

<style>
  nav {
    align-items: center;
    display: flex;
    flex: 1;
    font-family: var(--font-family-sans);
    font-weight: 700;
    justify-content: flex-end;
  }

  a {
    color: inherit;
    text-decoration: none;
    padding: 10px 5px;
    display: block;
    position: relative;
    margin-left: 20px;
    min-width: 70px;
    text-align: center;
  }

  a.selected {
    color: var(--primary-color);
  }
</style>

<nav>
  <a class={current === "" ? "selected" : ""} href='/'>home</a>
  <a class={current === "blog" ? "selected" : ""} href='/blog'>blog</a>
  <a class={current === "translations" ? "selected" : ""} href='/translations'>translations</a>
  
  <a href='https://dev.to/scumdograscalhouse' target="_blank" title="Go to archive">archive</a>
</nav>
